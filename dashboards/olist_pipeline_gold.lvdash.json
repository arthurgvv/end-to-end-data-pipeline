{
  "datasets": [
    {
      "name": "kpis",
      "displayName": "KPIs",
      "queryLines": [
        "SELECT SUM(orders) AS orders, SUM(gmv) AS gmv,\n",
        "       ROUND(SUM(gmv)/SUM(orders),2) AS avg_ticket,\n",
        "       (SELECT ROUND(AVG(review_score),2) FROM workspace.gold.fact_orders WHERE is_valid_sale) AS avg_review,\n",
        "       (SELECT ROUND(AVG(CAST(is_late AS INT)),4) FROM workspace.gold.fact_orders WHERE is_valid_sale) AS late_rate,\n",
        "       (SELECT COUNT(*) FROM workspace.gold.customer_rfm) AS customers\n",
        "FROM workspace.gold.agg_sales_monthly\n"
      ]
    },
    {
      "name": "monthly",
      "displayName": "Vendas mensais",
      "queryLines": [
        "SELECT TO_DATE(CONCAT(year_month,'-01')) AS month, orders, gmv, avg_ticket, late_rate, avg_review_score\n",
        "FROM workspace.gold.agg_sales_monthly WHERE year_month BETWEEN '2017-01' AND '2018-08'\n"
      ]
    },
    {
      "name": "category",
      "displayName": "Top categorias",
      "queryLines": [
        "SELECT category_name, revenue, avg_review_score FROM workspace.gold.agg_category_performance\n",
        "WHERE revenue_rank <= 10\n"
      ]
    },
    {
      "name": "state",
      "displayName": "Por UF",
      "queryLines": [
        "SELECT state, region, gmv, orders, avg_delivery_days, late_rate FROM workspace.gold.agg_state_performance\n"
      ]
    },
    {
      "name": "late_vs_review",
      "displayName": "Atraso x nota",
      "queryLines": [
        "SELECT CASE WHEN is_late THEN 'Atrasado' WHEN NOT is_late THEN 'No prazo' ELSE 'Nao entregue' END AS entrega,\n",
        "       ROUND(AVG(review_score),2) AS nota_media, COUNT(*) AS pedidos\n",
        "FROM workspace.gold.fact_orders WHERE review_score IS NOT NULL GROUP BY 1\n"
      ]
    },
    {
      "name": "rfm",
      "displayName": "Segmentos RFM",
      "queryLines": [
        "SELECT segment, COUNT(*) AS clientes, ROUND(SUM(monetary),2) AS receita FROM workspace.gold.customer_rfm GROUP BY segment\n"
      ]
    },
    {
      "name": "payment",
      "displayName": "Pagamentos",
      "queryLines": [
        "SELECT payment_type, total_value FROM workspace.gold.agg_payment_methods\n"
      ]
    },
    {
      "name": "dq",
      "displayName": "Qualidade",
      "queryLines": [
        "SELECT layer, severity, check_name, violations, passed, checked_at FROM workspace.gold.data_quality_log\n",
        "WHERE run_id = (SELECT MAX_BY(run_id, checked_at) FROM workspace.gold.data_quality_log)\n"
      ]
    }
  ],
